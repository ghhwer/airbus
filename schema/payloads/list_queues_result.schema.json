{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbus.local/schema/payloads/list_queues_result.schema.json",
  "title": "ListQueuesResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["queues"],
  "properties": {
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "depth", "mode", "listener_count"],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/QueueName"
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "$ref": "common.schema.json#/$defs/QueueMode"
          },
          "listener_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
