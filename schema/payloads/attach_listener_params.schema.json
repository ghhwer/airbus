{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbus.local/schema/payloads/attach_listener_params.schema.json",
  "title": "AttachListenerParams",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue", "port"],
  "properties": {
    "queue": {
      "$ref": "common.schema.json#/$defs/QueueName"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "host": {
      "type": "string"
    },
    "exhaustion_timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0
    },
    "side": {
      "$ref": "common.schema.json#/$defs/DuplexSide",
      "description": "Listener side for full-duplex queues; required when mode is full-duplex, rejected otherwise"
    }
  }
}
