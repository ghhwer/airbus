{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbus.local/schema/payloads/common.schema.json",
  "title": "Common",
  "$defs": {
    "QueueName": {
      "title": "QueueName",
      "type": "string",
      "minLength": 1
    },
    "EventObject": {
      "title": "EventObject",
      "type": "object",
      "additionalProperties": true
    },
    "QueueMode": {
      "title": "QueueMode",
      "type": "string",
      "enum": ["broadcast", "fifo", "full-duplex"]
    },
    "QueueInfo": {
      "title": "QueueInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "depth", "mode", "listener_count"],
      "properties": {
        "name": {
          "$ref": "#/$defs/QueueName"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/QueueMode"
        },
        "listener_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DuplexSide": {
      "title": "DuplexSide",
      "type": "string",
      "enum": ["host", "device"]
    },
    "DispatchStrategy": {
      "title": "DispatchStrategy",
      "type": "string",
      "enum": ["round_robin", "single_node"]
    }
  }
}
