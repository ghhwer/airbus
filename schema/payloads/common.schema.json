{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbus.local/schema/payloads/common.schema.json",
  "title": "Common",
  "$defs": {
    "QueueName": {
      "title": "QueueName",
      "type": "string",
      "minLength": 1
    },
    "EventObject": {
      "title": "EventObject",
      "type": "object",
      "additionalProperties": true
    },
    "QueueMode": {
      "title": "QueueMode",
      "type": "string",
      "enum": ["broadcast", "fifo", "full-duplex"]
    },
    "DuplexSide": {
      "title": "DuplexSide",
      "type": "string",
      "enum": ["host", "device"]
    },
    "DispatchStrategy": {
      "title": "DispatchStrategy",
      "type": "string",
      "enum": ["round_robin", "single_node"]
    }
  }
}
